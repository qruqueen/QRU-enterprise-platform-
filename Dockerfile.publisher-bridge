FROM python:3.12-slim

WORKDIR /app
COPY backend/requirements.publisher-bridge.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
COPY backend /app/backend
WORKDIR /app/backend

ENV PORT=8000
CMD ["sh", "-c", "uvicorn publisher_bridge_app:app --host 0.0.0.0 --port ${PORT}"]
